# Copy to `.env` and review. Never commit the real `.env`.
# Values below are placeholders for the M0 scaffold; services are wired up per milestone.

# --- Postgres (catalog) ---
# `localhost` is correct for host-run tools (make demo / pipeline / scale / dashboard),
# which reach the container via the published 5432 port. Only set this to `postgres`
# (the compose service name) if you run the pipeline INSIDE the compose network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=robot_learning
POSTGRES_USER=rlde
POSTGRES_PASSWORD=change_me

# --- Storage budget (mirrors config/sources.yaml; that file is authoritative) ---
STORAGE_BUDGET_GB=25
DATA_ROOT=./data

# --- Hugging Face (public datasets; token only needed for gated repos) ---
HF_TOKEN=
HF_HOME=./data/hf_cache

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# --- ELK ---
ELASTIC_PORT=9200
KIBANA_PORT=5601

# --- Dashboard (Kibana vs Streamlit is an open DECISION — see docs/01-conception.md §4.8) ---
DASHBOARD=kibana
STREAMLIT_PORT=8501
